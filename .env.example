# ==============================================================================
# Pravah V2 - Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit real credentials or .env to version control.
# ==============================================================================

# PostgreSQL + PostGIS Database Configuration
POSTGRES_DB=pravah_v2
POSTGRES_USER=pravah_user
POSTGRES_PASSWORD=pravah_secure_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Primary Database Connection URL (Prisma / PostGIS)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://pravah_user:pravah_secure_dev_password@localhost:5432/pravah_v2?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Configuration
JWT_SECRET=pravah-v2-dev-secret-key-change-in-production-min32chars
JWT_EXPIRES_IN=24h
